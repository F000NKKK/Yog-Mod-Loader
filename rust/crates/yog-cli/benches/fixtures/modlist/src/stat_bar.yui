<Component name="StatBar" description="@Strings.component.stat_bar" icon="item:experience_bottle" design_w="120" design_h="16">
    <Property name="label" type="text" default="Progress" doc="Caption above the bar"/>
    <Property name="value" type="number" default="0.5" doc="Filled fraction, 0..1"/>
    <Property name="fill" type="color" default="#FF55C055" doc="Bar color" category="Appearance"/>
    <Property name="track" type="color" default="#FF303030" doc="Empty part's color" category="Appearance"/>
    <Property name="percent" type="bool" default="true" doc="Show the value as a percentage"/>
    <Column min_w="60" gap="2">
        <Label text="{x:Bind caption()}" color="#FFDDDDDD" shadow="false" no_wrap="true"/>
        <Row w="100%" h="5" bg="{x:Bind track}">
            <Spacer w="{x:Bind filled()}" h="100%" bg="{x:Bind fill}"/>
        </Row>
    </Column>
</Component>
