static __HANDLE: ::std::sync::OnceLock<::yog_kit::ScreenHandle<ModListVm>> = ::std::sync::OnceLock::new();

/// Registers the screen (rendering + input) with a new view model
/// (`<ModListVm as ::std::default::Default>::default()`); returns its handle. Call once, from `Mod::register`.
#[allow(dead_code, private_interfaces)]
pub fn register(registry: &mut ::yog_api::Registry) -> ::yog_kit::ScreenHandle<ModListVm> {
    register_with(registry, <ModListVm as ::std::default::Default>::default())
}

/// [`register`] with a given view model.
#[allow(dead_code, private_interfaces)]
pub fn register_with(registry: &mut ::yog_api::Registry, vm: ModListVm) -> ::yog_kit::ScreenHandle<ModListVm> {
    ::std::clone::Clone::clone(__HANDLE.get_or_init(|| ::yog_kit::Screen::<View>::register(registry, vm)))
}

/// The handle [`register`] returned (`None` before it).
#[allow(dead_code, private_interfaces)]
pub fn handle() -> ::std::option::Option<::yog_kit::ScreenHandle<ModListVm>> {
    __HANDLE.get().cloned()
}

/// Opens the screen (modal: true, pauses the game: false).
#[allow(dead_code)]
pub fn open() {
    ::yog_api::open_ui(ID, true, false);
}

/// Closes the screen if it's open.
#[allow(dead_code)]
pub fn close() {
    ::yog_api::close_ui(ID);
}

