            ::yog_kit::ViewEvent::Action(::yog_api::ui::Action { owner: 0, slot: 2, .. }) => {
                vm.set_filter(Filter::Platform);
            }
            ::yog_kit::ViewEvent::Action(::yog_api::ui::Action { owner: 1, slot: ::yog_kit::items::SELECT, index })
            | ::yog_kit::ViewEvent::Select { list: 1, index } => {
