/// Registers every block and item of `content/` whose file doesn't say
/// `"register": "manual"` — `yog_api::content!()` calls it after
/// `Mod::register`.
#[allow(unused_variables)]
pub fn register(registry: &mut ::yog_api::Registry) {
    registry.register_item(Items::ruby());
    registry.add_recipe(::yog_api::Recipe { id: "gm:ruby".into(), kind: ::yog_api::RecipeKind::Shapeless { ingredients: vec![vec!["minecraft:redstone".into()]] }, result: "gm:ruby".into(), count: 1, group: None, category: None });
    registry.register_book_data("gm:guide", include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"), "/generated/books/gm__guide.ydata")));
}

// Runs when the mod's library loads: `export_mod!` calls `register` after
// `Mod::register`.
#[::yog_api::ctor::ctor(unsafe, crate_path = ::yog_api::ctor)]
fn __yog_content_auto_register() {
    ::yog_api::__yog_content_registrars()
        .lock()
        .unwrap_or_else(|e| e.into_inner())
        .push(register);
}

