# content/blocks.g.rs
// Generated by `yog build` from content/** — don't edit; it's rewritten on every build.

/// The blocks of `content/`: the id and a [`::yog_api::BlockDef`] of each.
#[allow(dead_code)]
pub struct Blocks;

#[allow(dead_code, clippy::all)]
impl Blocks {
    /// `gm:glass` — `content/glass.yblock`.
    pub const GLASS: &'static str = "gm:glass";
    /// The definition from `content/glass.yblock` (name and tooltip come from the lang files).
    pub fn glass() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::GLASS)
            .strength(0.3, 6.0)
            .sound("minecraft:glass")
    }
    /// `gm:ore` — `content/ore.yblock`.
    pub const ORE: &'static str = "gm:ore";
    /// The definition from `content/ore.yblock` (name and tooltip come from the lang files).
    pub fn ore() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::ORE)
            .strength(3.0, 3.0)
            .sound("minecraft:stone")
            .light_level(4)
            .requires_tool()
    }
    /// `gm:pipe` — `content/pipe.yblock`.
    pub const PIPE: &'static str = "gm:pipe";
    /// The definition from `content/pipe.yblock` (name and tooltip come from the lang files).
    pub fn pipe() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::PIPE)
            .shape([6.0, 6.0, 6.0], [10.0, 10.0, 10.0])
            .connects_to_neighbors()
            .connect_groups(&["gm:pipe"])
    }
}

