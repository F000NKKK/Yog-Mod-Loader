        "north": "true"
      }
    },
    {
      "apply": {
        "model": "gm:block/fence_side",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "gm:block/fence_side",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "gm:block/fence_side",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "true"
      }
    }
  ]
}
