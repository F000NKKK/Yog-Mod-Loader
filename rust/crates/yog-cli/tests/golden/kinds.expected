# content/register.g.rs
// Generated by `yog build` from content/** — don't edit; it's rewritten on every build.

/// Registers every block and item of `content/` whose file doesn't say
/// `"register": "manual"` — `yog_api::content!()` calls it after
/// `Mod::register`.
#[allow(unused_variables)]
pub fn register(registry: &mut ::yog_api::Registry) {
    registry.register_block(Blocks::button());
    registry.register_block(Blocks::door());
    registry.register_block(Blocks::fence());
    registry.register_block(Blocks::gate());
    registry.register_block(Blocks::planks());
    registry.register_block(Blocks::plate());
    registry.register_block(Blocks::slab());
    registry.register_block(Blocks::stairs());
    registry.register_block(Blocks::trapdoor());
}

// Runs when the mod's library loads: `export_mod!` calls `register` after
// `Mod::register`.
#[::yog_api::ctor::ctor(unsafe, crate_path = ::yog_api::ctor)]
fn __yog_content_auto_register() {
    ::yog_api::__yog_content_registrars().lock().push(register);
}

