# content.g.rs
// Generated by `yog build` from content/** — don't edit; it's rewritten on every build.
include!(concat!(env!("CARGO_MANIFEST_DIR"), "/generated/content/blocks.g.rs"));
include!(concat!(env!("CARGO_MANIFEST_DIR"), "/generated/content/items.g.rs"));
include!(concat!(env!("CARGO_MANIFEST_DIR"), "/generated/content/register.g.rs"));

# content/blocks.g.rs
// Generated by `yog build` from content/** — don't edit; it's rewritten on every build.

/// The blocks of `content/`: the id and a [`::yog_api::BlockDef`] of each.
#[allow(dead_code)]
pub struct Blocks;

#[allow(dead_code, clippy::all)]
impl Blocks {
    /// `gm:button` — `content/button.yblock`.
    pub const BUTTON: &'static str = "gm:button";
    /// The definition from `content/button.yblock` (name and tooltip come from the lang files).
    pub fn button() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::BUTTON)
            .no_collision()
            .kind("button")
            .set("stone")
            .press_ticks(20)
            .mobs_only()
    }
    /// `gm:door` — `content/door.yblock`.
    pub const DOOR: &'static str = "gm:door";
    /// The definition from `content/door.yblock` (name and tooltip come from the lang files).
    pub fn door() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::DOOR)
            .no_occlusion()
            .kind("door")
            .set("oak")
    }
    /// `gm:fence` — `content/fence.yblock`.
    pub const FENCE: &'static str = "gm:fence";
    /// The definition from `content/fence.yblock` (name and tooltip come from the lang files).
    pub fn fence() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::FENCE)
            .kind("fence")
    }
    /// `gm:gate` — `content/gate.yblock`.
    pub const GATE: &'static str = "gm:gate";
    /// The definition from `content/gate.yblock` (name and tooltip come from the lang files).
    pub fn gate() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::GATE)
            .kind("fence_gate")
            .set("dark_oak")
    }
    /// `gm:planks` — `content/planks.yblock`.
    pub const PLANKS: &'static str = "gm:planks";
    /// The definition from `content/planks.yblock` (name and tooltip come from the lang files).
    pub fn planks() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::PLANKS)
            .strength(2.0, 6.0)
            .sound("minecraft:wood")
    }
    /// `gm:plate` — `content/plate.yblock`.
    pub const PLATE: &'static str = "gm:plate";
    /// The definition from `content/plate.yblock` (name and tooltip come from the lang files).
    pub fn plate() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::PLATE)
            .no_collision()
            .kind("pressure_plate")
    }
    /// `gm:slab` — `content/slab.yblock`.
    pub const SLAB: &'static str = "gm:slab";
    /// The definition from `content/slab.yblock` (name and tooltip come from the lang files).
    pub fn slab() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::SLAB)
            .kind("slab")
            .base("gm:planks")
    }
    /// `gm:stairs` — `content/stairs.yblock`.
    pub const STAIRS: &'static str = "gm:stairs";
    /// The definition from `content/stairs.yblock` (name and tooltip come from the lang files).
    pub fn stairs() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::STAIRS)
            .strength(2.0, 6.0)
            .sound("minecraft:wood")
            .kind("stairs")
            .base("gm:planks")
    }
    /// `gm:trapdoor` — `content/trapdoor.yblock`.
    pub const TRAPDOOR: &'static str = "gm:trapdoor";
    /// The definition from `content/trapdoor.yblock` (name and tooltip come from the lang files).
    pub fn trapdoor() -> ::yog_api::BlockDef {
        ::yog_api::BlockDef::new(Self::TRAPDOOR)
            .kind("trapdoor")
    }
}

