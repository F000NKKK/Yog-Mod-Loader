{
  "mod_name": { "value": "Yog Mod List", "comment": "The mod's name (yog.toml name), shown in mod lists" },
  "mod_description": { "value": "In-game mod list browser. Shows loaded Yog mods and, on Fabric, platform mods.", "comment": "yog.toml description" },
  "menu.button": { "value": "Yog Mods", "comment": "Button the loader adds to the title screen / mod list screen" },
  "screen.title": { "value": "Yog Mods", "comment": "Header of the mod browser" },
  "screen.count": { "value": "{count} mods", "comment": "Header, right side: {count} = number of installed mods" },
  "screen.count_filtered": { "value": "{shown} of {total} mods", "comment": "Header when a filter or the search hides some" },
  "screen.done": { "value": "Done", "comment": "Button closing the screen" },
  "search.placeholder": { "value": "Search mods...", "comment": "Hint in the empty search box" },
  "filter.all": { "value": "All", "comment": "Filter button: every mod" },
  "filter.yog": { "value": "Yog", "comment": "Filter button: .yog mods only" },
  "filter.platform": { "value": "Platform", "comment": "Filter button: loader (Fabric/Forge/NeoForge) mods only" },
  "list.empty": { "value": "No mods", "comment": "List placeholder when the filter shows nothing" },
  "list.no_matches": { "value": "No mods match the search", "comment": "List placeholder when the search shows nothing" },
  "badge.yog": { "value": "[Yog]", "comment": "Short tag in a list row" },
  "badge.platform": { "value": "[MC]", "comment": "Short tag in a list row" },
  "row.version": { "value": "v{version}", "comment": "Version in a list row" },
  "source.yog": "Yog mod",
  "source.platform": "Platform mod",
  "details.version": "Version {version}",
  "details.authors": { "value": "by {authors}", "comment": "{authors} = comma-separated authors" },
  "details.authors_unknown": "by unknown",
  "details.id": "id: {id}",
  "details.no_description": "No description.",
  "details.none_selected": "No mod selected"
}
