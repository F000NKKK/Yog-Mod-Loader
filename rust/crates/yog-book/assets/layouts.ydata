  {
    kinds: ["smithing"],
    size: [96, 43],
    parts: [
      { type: "image", source: "yog:gui/book/crafting", uv: [11, 135, 96, 43], at: [0, 2] },
      { type: "slots", slot: "base", at: [[4, 6]] },
      { type: "slots", slot: "addition", at: [[4, 26]] },
