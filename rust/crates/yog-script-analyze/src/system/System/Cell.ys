namespace System;

/// A value changed through a shared reference, on one thread (Rust's `Cell`
/// and `RefCell`; across threads, a `Lock` or an `Atomic`).
[Intrinsic]
public sealed class Cell<T> {
    public Cell(T value) {}

    public readonly T Get();
    public readonly void Set(T value);
    /// The value put in, the one there given back.
    public readonly T Replace(T value);
    /// The value changed by `change`.
    public readonly void Update(Func<T, T> change);
}
