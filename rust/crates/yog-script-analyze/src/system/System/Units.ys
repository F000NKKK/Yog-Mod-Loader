namespace System;

/// The game's units of time as numbers: a quantity of `Seconds` is one of
/// `Ticks` where ticks are wanted (`Task.Delay(5s)`), through `ToTicks`.
[Intrinsic]
public static class Units {
    /// How many ticks the game runs a second.
    public const f64 TicksPerSecond = 20.0;
    /// `seconds` as ticks.
    public static Ticks ToTicks(Seconds seconds);
}
