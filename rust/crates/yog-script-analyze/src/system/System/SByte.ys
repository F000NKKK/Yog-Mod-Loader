namespace System;

/// `i8`'s members, as .NET's `System.SByte`: a whole number.
[Intrinsic]
[Host]
public readonly struct SByte : IComparable<i8>, IEquatable<i8> {
    public static readonly i8 MinValue;
    public static readonly i8 MaxValue;
    /// `s` read as one; a panic when it isn't one.
    public static i8 Parse(string s);
    /// `s` read as one, or `null` when it isn't one.
    public static i8? TryParse(string s);

    public i32 CompareTo(i8 value);
    public bool Equals(i8 obj);
    public override string ToString();
}
