namespace System;

/// A value set once, by whoever comes first (Rust's `OnceCell`/`OnceLock`,
/// .NET's `LazyInitializer`); thread-safe.
[Intrinsic]
public sealed class Once<T> {
    public Once() {}

    /// Sets it unless it's set: whether this did.
    public bool TrySet(T value);
    /// Its value, made by `make` if it's not set yet (once, whoever asks).
    public T GetOrInit(Func<T> make);
    /// Its value, `null` until it's set.
    public T? Get();
    public bool IsSet { get; }
}
