namespace System.Collections.Generic;

/// Values by their keys, in the keys' order, each found by its index too:
/// .NET's `SortedList<TKey, TValue>`.
[Intrinsic]
public class SortedList<TKey, TValue> : IDictionary<TKey, TValue>, IReadOnlyDictionary<TKey, TValue> {
    public SortedList() {}
    public SortedList(IComparer<TKey> comparer) {}

    public i32 Count { get; }
    public TValue this[TKey key] { get; set; }
    public ICollection<TKey> Keys { get; }
    public ICollection<TValue> Values { get; }
    public readonly IEnumerator<KeyValuePair<TKey, TValue>> GetEnumerator();
    public void Add(TKey key, TValue value);
    /// Whether `key`'s value was added (it had none).
    public bool TryAdd(TKey key, TValue value);
    public readonly bool ContainsKey(TKey key);
    public readonly bool ContainsValue(TValue value);
    public bool Remove(TKey key);
    public readonly TValue? TryGetValue(TKey key);
    /// `key`'s value, or `fallback` when it has none.
    public readonly TValue GetValueOrDefault(TKey key, TValue fallback);
    public void Clear();
    /// Where `key` is; -1 when it isn't.
    public readonly i32 IndexOfKey(TKey key);
    public readonly i32 IndexOfValue(TValue value);
    public readonly TKey GetKeyAtIndex(i32 index);
    public readonly TValue GetValueAtIndex(i32 index);
    public void RemoveAt(i32 index);

    // Its pairs as a collection's, through `ICollection<KeyValuePair<…>>` only.
    bool ICollection<KeyValuePair<TKey, TValue>>.IsReadOnly => false;
    void ICollection<KeyValuePair<TKey, TValue>>.Add(KeyValuePair<TKey, TValue> item);
    bool ICollection<KeyValuePair<TKey, TValue>>.Contains(KeyValuePair<TKey, TValue> item);
    bool ICollection<KeyValuePair<TKey, TValue>>.Remove(KeyValuePair<TKey, TValue> item);
    // Its keys and values as a read-only dictionary's.
    IEnumerable<TKey> IReadOnlyDictionary<TKey, TValue>.Keys => Keys;
    IEnumerable<TValue> IReadOnlyDictionary<TKey, TValue>.Values => Values;
}
