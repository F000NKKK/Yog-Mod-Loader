namespace System;

/// Numbers' functions, as .NET's: each of every width it takes, the
/// narrowest that fits chosen.
[Intrinsic]
public static class Math {
    /// The ratio of a circle's circumference to its diameter.
    public const f64 PI = 3.141592653589793;
    /// The base of natural logarithms.
    public const f64 E = 2.718281828459045;
    /// A full turn in radians: `2 * PI`.
    public const f64 Tau = 6.283185307179586;

    public static i32 Max(i32 a, i32 b);
    public static i64 Max(i64 a, i64 b);
    public static f32 Max(f32 a, f32 b);
    public static f64 Max(f64 a, f64 b);
    public static i32 Min(i32 a, i32 b);
    public static i64 Min(i64 a, i64 b);
    public static f32 Min(f32 a, f32 b);
    public static f64 Min(f64 a, f64 b);
    public static i32 Abs(i32 value);
    public static i64 Abs(i64 value);
    public static f32 Abs(f32 value);
    public static f64 Abs(f64 value);
    public static i32 Clamp(i32 value, i32 min, i32 max);
    public static i64 Clamp(i64 value, i64 min, i64 max);
    public static f32 Clamp(f32 value, f32 min, f32 max);
    public static f64 Clamp(f64 value, f64 min, f64 max);
    public static i32 Sign(i32 value);
    public static i32 Sign(i64 value);
    public static i32 Sign(f32 value);
    public static i32 Sign(f64 value);
    public static f64 Sqrt(f64 x);
    public static f64 Cbrt(f64 x);
    public static f64 Floor(f64 x);
    public static f64 Ceiling(f64 x);
    public static f64 Truncate(f64 x);
    public static f64 Exp(f64 x);
    public static f64 Log(f64 x);
    public static f64 Log2(f64 x);
    public static f64 Log10(f64 x);
    public static f64 Sin(f64 x);
    public static f64 Cos(f64 x);
    public static f64 Tan(f64 x);
    public static f64 Asin(f64 x);
    public static f64 Acos(f64 x);
    public static f64 Atan(f64 x);
    public static f64 Sinh(f64 x);
    public static f64 Cosh(f64 x);
    public static f64 Tanh(f64 x);
    /// `x` to the nearest whole number, a half to the even one (.NET's).
    public static f64 Round(f64 x);
    public static f64 Pow(f64 x, f64 y);
    public static f64 Atan2(f64 y, f64 x);
}
