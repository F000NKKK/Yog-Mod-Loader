namespace System;

/// `u32`'s members, as .NET's `System.UInt32`: a whole number.
[Intrinsic]
[Host]
public readonly struct UInt32 : IComparable<u32>, IEquatable<u32> {
    public static readonly u32 MinValue;
    public static readonly u32 MaxValue;
    /// `s` read as one; a panic when it isn't one.
    public static u32 Parse(string s);
    /// `s` read as one, or `null` when it isn't one.
    public static u32? TryParse(string s);

    public i32 CompareTo(u32 value);
    public bool Equals(u32 obj);
    public override string ToString();
}
