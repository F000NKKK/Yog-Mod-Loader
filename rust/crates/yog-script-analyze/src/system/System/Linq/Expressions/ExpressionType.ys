namespace System.Linq.Expressions;

/// What an expression tree's node is, as .NET's.
public enum ExpressionType {
    Add,
    And,
    AndAlso,
    ArrayIndex,
    Call,
    Coalesce,
    Conditional,
    Constant,
    Convert,
    Divide,
    Equal,
    ExclusiveOr,
    GreaterThan,
    GreaterThanOrEqual,
    Lambda,
    LeftShift,
    LessThan,
    LessThanOrEqual,
    MemberAccess,
    Modulo,
    Multiply,
    Negate,
    New,
    Not,
    NotEqual,
    Or,
    OrElse,
    Parameter,
    RightShift,
    Subtract,
}
