namespace System;

/// A method that takes nothing and gives nothing.
public delegate void Action();

/// A method that takes one value and gives nothing.
public delegate void Action<in T>(T obj);

/// A method that takes 2 values and gives nothing.
public delegate void Action<in T1, in T2>(T1 arg1, T2 arg2);

/// A method that takes 3 values and gives nothing.
public delegate void Action<in T1, in T2, in T3>(T1 arg1, T2 arg2, T3 arg3);

/// A method that takes 4 values and gives nothing.
public delegate void Action<in T1, in T2, in T3, in T4>(T1 arg1, T2 arg2, T3 arg3, T4 arg4);

/// A method that takes 5 values and gives nothing.
public delegate void Action<in T1, in T2, in T3, in T4, in T5>(T1 arg1, T2 arg2, T3 arg3, T4 arg4, T5 arg5);

/// A method that takes 6 values and gives nothing.
public delegate void Action<in T1, in T2, in T3, in T4, in T5, in T6>(T1 arg1, T2 arg2, T3 arg3, T4 arg4, T5 arg5, T6 arg6);

/// A method that takes 7 values and gives nothing.
