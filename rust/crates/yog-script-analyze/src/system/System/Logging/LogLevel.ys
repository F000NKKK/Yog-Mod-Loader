namespace System.Logging;

/// How much a log entry matters (.NET's `Microsoft.Extensions.Logging.LogLevel`):
/// a logger writes those at its minimum and above; `None` writes nothing.
public enum LogLevel {
    Trace = 0,
    Debug = 1,
    Information = 2,
    Warning = 3,
    Error = 4,
    Critical = 5,
    None = 6,
}
