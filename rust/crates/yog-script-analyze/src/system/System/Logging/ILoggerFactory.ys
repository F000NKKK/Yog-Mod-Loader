namespace System.Logging;

/// What makes loggers of categories, from the providers added to it (.NET's `ILoggerFactory`).
public interface ILoggerFactory : IDisposable {
    readonly ILogger CreateLogger(string categoryName);

    readonly void AddProvider(ILoggerProvider provider);
}

/// What makes the loggers that write somewhere (.NET's `ILoggerProvider`):
/// a console, a file, the game's log.
public interface ILoggerProvider : IDisposable {
    readonly ILogger CreateLogger(string categoryName);
}
