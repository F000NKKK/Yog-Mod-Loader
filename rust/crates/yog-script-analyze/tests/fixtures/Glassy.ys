mod Glassy {
    Version = "1.0.0";
    Targets = mc 1.20.1..26.2;

    const string Prefix = "g";

    // The mod's constructor runs when it loads: its subscriptions.
    Glassy() {
        Block.Break += e => {
            if (e.PlayerName.StartsWith(Prefix)) {
                new World(e.Dimension).SetBlock(e.Pos, "minecraft:glass");
            }
        };
    }
}
